# ============================================================
# 📱 1. PERSONAL WHATSAPP ALERTS (CallMeBot - 100% Free)
# 1. Save +34 644 44 49 97 in your phone contacts as CallMeBot
# 2. Send WhatsApp message: "I allow callmebot to send me messages"
# 3. CallMeBot will reply with your free API Key
# ============================================================
WHATSAPP_PHONE=+919876543210
WHATSAPP_APIKEY=your_callmebot_api_key_here

# ============================================================
# 📢 2. TELEGRAM BROADCASTING (100% Free)
# 1. Create a bot with @BotFather on Telegram (get Bot Token)
# 2. Create a channel/group, add your bot as Admin
# 3. Set TELEGRAM_CHAT_ID to @your_channel_name
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# ============================================================
# 💬 3. DISCORD WEBHOOK (Optional - 100% Free)
# Server Settings -> Integrations -> Webhooks
# ============================================================
DISCORD_WEBHOOK_URL=
